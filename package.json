{
  "name": "presentation-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/validate-karaoke.mjs && node scripts/build-catalog.mjs && vite build && node scripts/copy-static-artifacts.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "dev": "node scripts/build-catalog.mjs && vite",
    "karaoke": "node scripts/build-karaoke.mjs",
    "preview": "vite preview",
    "review": "playwright test tests/visual-review.spec.ts --workers=1",
    "test": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
